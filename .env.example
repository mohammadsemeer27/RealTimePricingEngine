# Server Configuration
HTTP_PORT=8080
LOG_LEVEL=info

# Upstream LiveFXHub WebSocket Configuration
UPSTREAM_WS_URL=wss://v3-prod.livefxhub.com/ws/algo
UPSTREAM_API_KEY=your_api_key_here
UPSTREAM_SECRET_KEY=your_secret_key_here
UPSTREAM_USE_MOCK=false
UPSTREAM_RECONNECT_INITIAL_MS=500
UPSTREAM_RECONNECT_MAX_MS=30000
UPSTREAM_READ_TIMEOUT_MS=15000

# Market Engine Configuration
ROLLING_WINDOW_HOURS=24

# Downstream WebSocket Server Configuration
WS_MAX_CONNECTIONS=1000
WS_CLIENT_QUEUE_SIZE=256
WS_WRITE_TIMEOUT_MS=5000
WS_PING_INTERVAL_MS=30000
WS_PONG_WAIT_MS=35000
WS_ENABLE_COMPRESSION=true

# PostgreSQL Persistence Configuration
DATABASE_URL=postgres://pricing_user:pricing_pass@localhost:5432/pricing_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SEC=300
DB_BATCH_SIZE=100
DB_FLUSH_INTERVAL_MS=200
DB_ENABLE_PERSISTENCE=true
